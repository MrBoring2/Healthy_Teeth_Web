@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using Shared.Models
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using WebSite.Providers
@layout LoginLayout

<RadzenLayout class="d-flex align-center justify-content-center" Style="height:100vh;">
    <RadzenTemplateForm Data="@loginModel" Submit="@((LoginModel model) => { Authenticate(); })" class="d-flex justify-content-center align-items-center rz-mb-8">
        <RadzenStack AlignItems="AlignItems.Center">
            <RadzenCard Style="width: 100%; width: 500px;">
                <RadzenStack Gap="2rem" class="rz-p-4 rz-p-md-12">
                    <RadzenText TextStyle="TextStyle.H4" TextAlign="TextAlign.Center">Авторизация</RadzenText>
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="3" class="rz-text-align-start rz-text-align-md-end">
                            <RadzenLabel Text="Логин" Component="Login" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="9">
                            <RadzenTextBox Style="display: block" Placeholder="Логин" @bind-Value="@loginModel.Login" Name="Login" class="rz-w-100" />
                            <RadzenDataAnnotationValidator Component="Login" Popup=true Style="position: relative" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" RowGap="0.25rem">
                        <RadzenColumn Size="12" SizeMD="3" class="rz-text-align-start rz-text-align-md-end">
                            <RadzenLabel Text="Пароль" Component="Password" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="9">
                            <RadzenPassword Style="display: block" Placeholder="Пароль" @bind-Value="@loginModel.Password" Name="Password" class="rz-w-100" />
                            <RadzenDataAnnotationValidator Component="Password" Popup=true Style="position: relative" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem" class="rz-mt-8 rz-mb-4">
                        <RadzenButton ButtonType="ButtonType.Submit" Size="ButtonSize.Large" Text="Войти" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenLayout>