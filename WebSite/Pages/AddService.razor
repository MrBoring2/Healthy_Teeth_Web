@using Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Shared.DTO
@using Shared.Models
@using WebSite.Providers
@using WebSite.Services;
@using WebSite.Services.ApiServices
@inject NavigationManager NavigationManager
@inject CustomStateProvider _authStateProvider
@inject IServiceApiService _apiService
<h1>Карточка услуги</h1>
<hr />
<CascadingAuthenticationState>
    <AuthorizeView Roles="@($"{Shared.Constants.Roles.ADMIN}")">
        <Authorized>
            <EditForm Model="@service" Context="editContext" OnValidSubmit="SaveService">
                <RadzenStack>
                    <RadzenFormField Text="Название">
                        <RadzenTextBox Placeholder="Название" @bind-Value="@service.Title" />
                    </RadzenFormField>
                    <RadzenFormField Text="Стоимость">
                        <RadzenNumeric Placeholder="Стоимость" @bind-Value="@service.Price" />
                    </RadzenFormField>
                    <RadzenFormField Text="Специализация">
                        <RadzenDropDown Placeholder="Выберите специализацию" Data="@Specializations" @bind-Value=@service.SpecializationId TextProperty="@nameof(SpecializationDTO.Title)" ValueProperty="@nameof(SpecializationDTO.Id)" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenButton Text="Сохранить" Click="@SaveService" />
                        <RadzenButton Click="@((args) => DialogService.Close(false))" Variant="Variant.Flat" Text="Закрыть" Style="width: 120px" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>
        </Authorized>
    </AuthorizeView>
</CascadingAuthenticationState>